{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "resolveJsonModule": true, "jsx": "react",
    "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node", "vitest/globals"], "esModuleInterop": true
  },
  "include": ["src", "scripts", "tests", "*.config.ts"]
}
