{
  "name": "dsh-sudoku-mini",
  "version": "0.1.1",
  "description": "Compact, local Sudoku and 2048 overlay for DeepSeek Harness Web UI",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "docs"],
  "engines": { "node": "^22.19.0 || >=24.11.0", "dsh": "0.1.5-rc.2" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-layout"] }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsdown",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "puzzles:generate": "node scripts/generate-puzzles.ts",
    "puzzles:validate": "node scripts/validate-puzzles.ts",
    "check:artifacts": "node scripts/check-artifacts.ts",
    "prepack": "pnpm puzzles:validate && pnpm build && pnpm check:artifacts"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "sudoku"],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@playwright/test": "1.55.1",
    "react": "^18.2.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "4.0.2" }
}
